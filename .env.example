# Live voice sessions are started explicitly from the dashboard.
# Restricted keys: Live Write + Responses Write (Live's internal history compaction).
OPENAI_API_KEY=
# Optional override for config.live.personaPath (absolute or repository-relative).
# KOKOMI_PERSONA_PATH=C:/GitHub/kokomi-persona/kokomi_origin.md
# Required only when config.live.enabled=false and legacy ASR/TTS is enabled.
ELEVENLABS_API_KEY=
