{
    "audit": {
        "validTopLevelFields": ["turn_id", "result", "actions", "requests", "memory_extraction", "memory_verification"]
    },

    "actions": {
        "tear": {
            "endpointUrl": "http://kokomi.local:5000/motor/command",
            "speedMin": 0,
            "speedMax": 255,
            "durationMin": 0,
            "durationMax": 255
        },
        "ledChange": {
            "endpointUrl": "http://kokomi.local:5000/led/command",
            "colorPattern": "^#[0-9A-Fa-f]{6}$"
        },
        "blueskyPost": {
            "serviceUrl": "https://bsky.social",
            "maxTextLength": 300
        }
    },

    "sensors": {
        "bme280Url": "http://kokomi.local:5000/bme280/sensor_data",
        "brightnessUrl": "http://192.168.0.149:5000/cds/sensor_data",
        "bme280PollIntervalMs": 1000,
        "brightnessPollIntervalMs": 1000,
        "brightnessResponseFields": ["brightness", "cds"],
        "brightnessDarkThreshold": 40,
        "units": {
            "temperature": "celsius",
            "humidity": "percent",
            "pressure": "hpa",
            "brightness": "raw"
        }
    },

    "behavior": {
        "freshness": {
            "environment_ms": 15000,
            "brightness_ms": 15000,
            "sound_ms": 5000,
            "person_ms": 300000,
            "touch_ms": 30000
        },
        "thresholds": {
            "cold_celsius": 18,
            "warm_celsius": 27,
            "hot_celsius": 31,
            "dark_brightness": 40,
            "bright_brightness": 75
        },
        "cooldowns": {
            "greet_person_ms": 120000,
            "respond_to_touch_ms": 10000,
            "mention_temperature_ms": 900000,
            "mention_darkness_ms": 900000,
            "homeostasis_ms": 300000
        },
        "proposal_ttl_ms": 30000,
        "spontaneous": {
            "enabled": false,
            "armed": false,
            "interval_ms": 5000,
            "minimum_priority": 70
        },
        "drives": {
            "social_need_full_after_ms": 14400000,
            "external_signal_stale_ms": 300000
        },
        "persona": {
            "id": "kokomi-origin",
            "version": "604b425e381c5a3c6a523c4715078fbb8ba72bec",
            "delivery": "session_bootstrap"
        }
    },

    "memory": {
        "storagePath": "./data/runtime/memory.json",
        "retrievalLimit": 5,
        "extraction": {
            "enabled": true,
            "intervalSeconds": 60,
            "flushOnSessionEnd": true,
            "retryIntervalSeconds": 30,
            "maxConsecutiveFailures": 3,
            "stableSilenceMs": 2000,
            "maxBatchBytes": 16000,
            "maxBatchGroups": 16,
            "summaryBudgetTokens": 1600
        }
    },

    "responses": {
        "url": "https://api.openai.com/v1/responses",
        "model": "gpt-6-luna",
        "reasoningEffort": "low",
        "timeoutMs": 30000,
        "maxOutputTokens": 4096,
        "webSearchEnabled": true
    },

    "live": {
        "enabled": true,
        "model": "gpt-live-1",
        "voice": "harema",
        "apiBaseUrl": "https://api.openai.com/v1/live",
        "socketBaseUrl": "wss://api.openai.com/v1/live",
        "instructionsPath": "./prompts/live-conversation.md",
        "personaPath": "../kokomi-persona/kokomi_origin.md",
        "conversationPath": "./data/runtime/live-conversations.jsonl",
        "checkpointPath": "./data/runtime/live-memory-checkpoint.json",
        "allowedOrigins": ["http://localhost:3000", "http://127.0.0.1:3000", "http://[::1]:3000"],
        "requestTimeoutMs": 15000,
        "closeTimeoutMs": 5000,
        "iceTimeoutMs": 10000,
        "heartbeatIntervalMs": 5000,
        "heartbeatTimeoutMs": 20000,
        "silenceWarningSeconds": 60,
        "silenceWarningRepeatSeconds": 60,
        "silenceAudioLevel": 0.02,
        "audioStatsIntervalMs": 1000,
        "stateSyncIntervalMs": 2000,
        "maxEventBytes": 1048576,
        "maxPendingAppends": 32,
        "initialContextBudgetTokens": 6000,
        "initialHistoryMessages": 24,
        "updateBudgetTokens": 450,
        "retrievalLimit": 5,
        "retrievalHistoryMessages": 4,
        "backendHistoryMessages": 12,
        "backendInputBudgetTokens": 8000,
        "maxBackendSteps": 4,
        "delegationQuietMs": 1200,
        "delegationContextTimeoutMs": 15000,
        "delegationTtlMs": 300000,
        "intoxicationSignal": "intoxication",
        "quantization": {
            "lightIntoxication": 0.2,
            "moderateIntoxication": 0.6
        }
    },

    "social": {
        "storagePath": "./data/runtime/social.json"
    },

    "persistence": {
        "eventLogPath": "./data/runtime/observations.jsonl",
        "maxReplayEvents": 20000,
        "sensorCheckpointMs": 60000
    },

    "actionGate": {
        "enabled": true,
        "max_actions_per_turn": 1,
        "duplicate_window_ms": 30000,
        "allowed_spontaneous_actions": [],
        "cooldowns": {
            "tear_ms": 10000,
            "led_change_ms": 2000,
            "bluesky_post_ms": 300000,
            "remember_person_ms": 60000
        }
    },

    "outcomes": {
        "reportToLlm": true
    },

    "audio": {
        "source": "yamnet",
        "forwardToLlm": false,
        "allowedLevels": ["quiet", "low", "medium", "high", "loud"]
    },

    "touch": {
        "source": "touch",
        "startedType": "touch_started",
        "endedType": "touch_ended",
        "sensorBindings": {
            "touch_01": "head",
            "touch_02": "hand",
            "touch_03": "shoulder"
        },
        "startedAction": "petting_started",
        "endedAction": "petting_ended"
    },

    "vision": {
        "snapshotUrl": "http://localhost:5000/snapshot",
        "snapshotTimeoutMs": 10000,
        "maxImageBytes": 10485760,
        "task": "describe_scene"
    },

    "faceMemory": {
        "enrollUrl": "http://localhost:5000/faces/enroll",
        "requestTimeoutMs": 10000,
        "maxNameLength": 80
    },

    "routes": {
        "yoloEvent": "/yolo_event",
        "touchSensorInput": "/touch_sensor_input",
        "userInput": "/user_input",
        "audioClassification": "/audio_classification",
        "internalState": "/internal_state",
        "behaviorState": "/api/behavior/state",
        "behaviorTick": "/api/behavior/tick",
        "memoryProposals": "/api/memory/proposals",
        "socialProposals": "/api/social/proposals"
    },

    "server": {
        "port": 3000
    }
}
