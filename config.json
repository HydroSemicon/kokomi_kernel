{
    "browser": {
        "chatInputSelector": "textarea, div[contenteditable=\"true\"]",
        "assistantOutputSelector": ".markdown.prose",
        "sendButtonSelector": "button[data-testid=\"send-button\"]",
        "enabledSendButtonSelector": "button[data-testid=\"send-button\"]:not([disabled])",
        "imageUploadSelector": "input[data-testid=\"upload-photos-input\"]",
        "remoteDebuggingUrl": "http://127.0.0.1:9222",
        "chatgptUrl": "https://chatgpt.com/",
        "existingPageUrlIncludes": ["chatgpt.com", "chat.openai.com"],
        "inputTimeoutMs": 60000,
        "typeDelayMs": 0,
        "outputPollIntervalMs": 300,
        "chromeConnectErrorMessage": "Failed to connect to Chrome. Start Chrome with: chrome.exe --remote-debugging-port=9222 --user-data-dir=\"C:\\chrome-debug-profile\""
    },

    "audit": {
        "validTopLevelFields": ["turn_id", "speech", "emotion", "intensity", "actions", "requests", "memory_proposals", "social_proposals"],
        "maxPendingTurns": 32,
        "pendingTurnTtlMs": 300000,
        "validEmotions": [
            "neutral",
            "happy",
            "calm",
            "sad",
            "angry",
            "surprised",
            "fear",
            "thinking"
        ],
        "intensityMin": 0.0,
        "intensityMax": 1.0
    },

    "actions": {
        "tear": {
            "endpointUrl": "http://kokomi.local:5000/motor/command",
            "speedMin": 0,
            "speedMax": 255,
            "durationMin": 0,
            "durationMax": 255
        },
        "ledChange": {
            "endpointUrl": "http://kokomi.local:5000/led/command",
            "colorPattern": "^#[0-9A-Fa-f]{6}$"
        },
        "blueskyPost": {
            "serviceUrl": "https://bsky.social",
            "maxTextLength": 300
        }
    },

    "sensors": {
        "bme280Url": "http://kokomi.local:5000/bme280/sensor_data",
        "brightnessUrl": "http://192.168.0.149:5000/cds/sensor_data",
        "bme280PollIntervalMs": 1000,
        "brightnessPollIntervalMs": 1000,
        "brightnessResponseFields": ["brightness", "cds"],
        "brightnessDarkThreshold": 40,
        "units": {
            "temperature": "celsius",
            "humidity": "percent",
            "pressure": "hpa",
            "brightness": "raw"
        }
    },

    "behavior": {
        "freshness": {
            "environment_ms": 15000,
            "brightness_ms": 15000,
            "sound_ms": 5000,
            "person_ms": 300000,
            "touch_ms": 30000
        },
        "thresholds": {
            "cold_celsius": 18,
            "warm_celsius": 27,
            "hot_celsius": 31,
            "dark_brightness": 40,
            "bright_brightness": 75
        },
        "cooldowns": {
            "greet_person_ms": 120000,
            "respond_to_touch_ms": 10000,
            "mention_temperature_ms": 900000,
            "mention_darkness_ms": 900000,
            "homeostasis_ms": 300000
        },
        "proposal_ttl_ms": 30000,
        "spontaneous": {
            "enabled": false,
            "armed": false,
            "interval_ms": 5000,
            "minimum_priority": 70
        },
        "drives": {
            "social_need_full_after_ms": 14400000,
            "external_signal_stale_ms": 300000
        },
        "persona": {
            "id": "kokomi-origin",
            "version": "604b425e381c5a3c6a523c4715078fbb8ba72bec",
            "delivery": "session_bootstrap"
        }
    },

    "memory": {
        "storagePath": "./data/runtime/memory.json",
        "retrievalLimit": 5
    },

    "social": {
        "storagePath": "./data/runtime/social.json"
    },

    "persistence": {
        "eventLogPath": "./data/runtime/observations.jsonl",
        "maxReplayEvents": 20000,
        "sensorCheckpointMs": 60000
    },

    "actionGate": {
        "enabled": true,
        "max_actions_per_turn": 1,
        "duplicate_window_ms": 30000,
        "allowed_spontaneous_actions": [],
        "cooldowns": {
            "tear_ms": 10000,
            "led_change_ms": 2000,
            "bluesky_post_ms": 300000,
            "remember_person_ms": 60000
        }
    },

    "outcomes": {
        "reportToLlm": true
    },

    "audio": {
        "source": "yamnet",
        "forwardToLlm": false,
        "allowedLevels": ["quiet", "low", "medium", "high", "loud"]
    },

    "touch": {
        "source": "touch",
        "startedType": "touch_started",
        "endedType": "touch_ended",
        "sensorBindings": {
            "touch_01": "head",
            "touch_02": "hand",
            "touch_03": "shoulder"
        },
        "startedAction": "petting_started",
        "endedAction": "petting_ended"
    },

    "asr": {
        "enabled": false,
        "provider": "elevenlabs_scribe",
        "modelId": "scribe_v2_realtime",
        "languageCode": "ja",
        "commitStrategy": "vad",
        "vadSilenceThresholdSecs": 0.8,
        "minSpeechDurationMs": 250,
        "partialTtlMs": 2000,
        "maxTextLength": 2000,
        "tokenRouteLoopbackOnly": true
    },

    "tts": {
        "enabled": false,
        "provider": "elevenlabs",
        "baseUrl": "https://api.elevenlabs.io/v1/text-to-speech",
        "defaultVoiceId": "JgWCVquTJEvtfo5gWQkx",
        "defaultModelId": "eleven_v3",
        "defaultOutputFormat": "mp3_44100_128",
        "similarityBoost": 0.75,
        "speakerBoost": true,
        "stabilityAtIntensityZero": 0.65,
        "stabilityAtIntensityOne": 0.35,
        "styleAtIntensityZero": 0.0,
        "styleAtIntensityOne": 0.35,
        "echoGuardMs": 1000,
        "emotionTags": {
            "neutral": null,
            "happy": "[happily]",
            "calm": "[calmly]",
            "sad": "[sad]",
            "angry": "[angry]",
            "surprised": "[surprised]",
            "fear": "[worried]",
            "thinking": "[thoughtfully]"
        },
        "playerCommand": "ffplay",
        "playerArgs": [
            "-nodisp",
            "-autoexit",
            "-loglevel",
            "quiet",
            "-"
        ]
    },

    "vision": {
        "snapshotUrl": "http://localhost:5000/snapshot",
        "snapshotTimeoutMs": 10000,
        "attachmentTimeoutMs": 60000,
        "tempFileRetentionMs": 60000,
        "maxImageBytes": 10485760,
        "generateUrl": "http://localhost:11434/api/generate",
        "model": "llava",
        "stream": false,
        "defaultQuery": "describe the scene",
        "task": "describe_scene",
        "maxWords": 50,
        "instructionTemplate": "Describe the scene in English in 1-2 sentences, maximum {maxWords} words. Focus only on important objects, people, and actions. Do not repeat details.\n"
    },

    "faceMemory": {
        "enrollUrl": "http://localhost:5000/faces/enroll",
        "requestTimeoutMs": 10000,
        "maxNameLength": 80
    },

    "routes": {
        "yoloEvent": "/yolo_event",
        "touchSensorInput": "/touch_sensor_input",
        "userInput": "/user_input",
        "audioClassification": "/audio_classification",
        "internalState": "/internal_state",
        "behaviorState": "/api/behavior/state",
        "behaviorTick": "/api/behavior/tick",
        "memoryProposals": "/api/memory/proposals",
        "socialProposals": "/api/social/proposals",
        "asrToken": "/api/asr/token",
        "asrTranscript": "/asr/transcript"
    },

    "server": {
        "port": 3000
    }
}
